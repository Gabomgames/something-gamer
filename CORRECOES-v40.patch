diff -ruN '--exclude=CORRECOES-v40.patch' original/landing.js entrega/landing.js
--- original/landing.js	1969-12-31 21:00:00.000000000 -0300
+++ entrega/landing.js	2026-09-14 18:46:56.284984600 -0300
@@ -0,0 +1,62 @@
+/* =========================================
+   LANDING
+   Duas coisas pequenas, só na home.
+
+   1. O menu marca em qual faixa você está enquanto rola.
+   2. Depois de clicar num item, o "#events" sai da barra de endereço,
+      para o botão Voltar do navegador não virar uma fila de âncoras.
+
+   A rolagem suave em si é do CSS (scroll-behavior: smooth, mais
+   scroll-margin-top para o cabeçalho fixo não cobrir o título da faixa).
+   Está lá de propósito: quem pediu "reduzir movimento" no sistema
+   continua sem animação, e um script que forçasse a rolagem passaria
+   por cima dessa escolha.
+========================================= */
+
+const elos = [...document.querySelectorAll('nav a[href^="#"], .porta a[href^="#"]')];
+const faixas = [...document.querySelectorAll(".publico[id]")];
+
+if (elos.length && faixas.length) {
+
+    const LINHA_DO_CABECALHO = 96;
+
+    /** A faixa que está sob a linha logo abaixo do cabeçalho fixo. */
+    function faixaAtual() {
+        if (scrollY < 120) return "";
+        let escolhida = "";
+        for (const faixa of faixas) {
+            const caixa = faixa.getBoundingClientRect();
+            if (caixa.top <= LINHA_DO_CABECALHO && caixa.bottom > LINHA_DO_CABECALHO) escolhida = faixa.id;
+        }
+        // no fim da página a última faixa pode não alcançar a linha
+        const noFim = scrollY + innerHeight >= document.documentElement.scrollHeight - 4;
+        if (!escolhida && noFim) escolhida = faixas[faixas.length - 1].id;
+        return escolhida;
+    }
+
+    function marcar() {
+        const id = faixaAtual();
+        for (const elo of elos) {
+            const desteElo = id !== "" && elo.getAttribute("href") === `#${id}`;
+            elo.classList.toggle("atual", desteElo);
+            if (desteElo) elo.setAttribute("aria-current", "true");
+            else elo.removeAttribute("aria-current");
+        }
+        return id;
+    }
+
+    // sem throttle: o navegador ja limita o evento de rolagem a um por
+    // quadro, e marcar() so mede tres elementos
+    marcar();
+    addEventListener("scroll", marcar, { passive: true });
+    addEventListener("resize", marcar, { passive: true });
+
+    // deixa a barra de endereço limpa depois que a rolagem termina
+    for (const elo of elos) {
+        elo.addEventListener("click", () => {
+            setTimeout(() => {
+                history.replaceState(null, "", location.pathname + location.search);
+            }, 800);
+        });
+    }
+}
diff -ruN '--exclude=CORRECOES-v40.patch' original/limites.js entrega/limites.js
--- original/limites.js	1969-12-31 21:00:00.000000000 -0300
+++ entrega/limites.js	2026-09-14 13:59:37.297480600 -0300
@@ -0,0 +1,35 @@
+// Limite de frequência de escrita, valendo no servidor.
+//
+// O Firestore não tem rate limiting embutido, e sem isso um script posta em
+// laço: o feed vira lixo e a fila de denúncias do painel entope. O truque
+// suportado é este: a escrita e o carimbo de tempo vão no MESMO lote, e a
+// regra exige o carimbo com getAfter(). Como a regra confere que o carimbo
+// novo é igual a request.time e que o anterior é mais velho que a janela,
+// não adianta o cliente mentir nem pular o carimbo: sem carimbo a regra
+// recusa, e com carimbo repetido ela recusa também.
+//
+// Documento: limites/{uid}, um campo por ação.
+
+import { db } from "./firebase.js";
+import { doc, serverTimestamp, writeBatch } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-firestore.js";
+
+/**
+ * Escreve um documento junto com o carimbo da ação, em lote único.
+ *
+ * @param {string} uid        quem está escrevendo
+ * @param {string} chave      nome da ação ("post", "comentario", "denuncia")
+ * @param {object} destino    DocumentReference onde gravar
+ * @param {object} dados      conteúdo do documento
+ */
+export async function escreverComLimite(uid, chave, destino, dados) {
+    const lote = writeBatch(db);
+    lote.set(destino, dados);
+    lote.set(doc(db, "limites", uid), { [chave]: serverTimestamp() }, { merge: true });
+    await lote.commit();
+}
+
+/** Mensagem única para quando a regra recusa por frequência. */
+export function mensagemDeLimite(erro, acao = "isso") {
+    if (erro?.code !== "permission-denied") return null;
+    return `Você fez ${acao} agora há pouco. Espere alguns segundos e tente de novo.`;
+}
