+
+
+/* =========================================
+   TEMA CLARO: os botoes
+   A regra geral dos botoes pinta o texto de branco com !important e da
+   a eles um fundo branco translucido. No tema escuro isso funciona; no
+   claro o botao vira branco no branco e some (era 1.01:1 de contraste).
+   Aqui o texto e a borda ganham a tinta escura. Os botoes de acao
+   continuam violeta com texto claro, que passa nos dois temas.
+========================================= */
+
+html[data-theme="light"] .login-btn,
+html[data-theme="light"] .edit-profile-btn,
+html[data-theme="light"] .connect-btn,
+html[data-theme="light"] .panel-link,
+html[data-theme="light"] .back-btn,
+html[data-theme="light"] .back-button,
+html[data-theme="light"] .app-outline-button {
+    color:var(--tinta) !important;
+    border-color: rgb(var(--veu-rgb) / .18) !important;
+    background: rgb(var(--veu-rgb) / .05) !important;
+}
+
+html[data-theme="light"] .login-btn:hover,
+html[data-theme="light"] .panel-link:hover,
+html[data-theme="light"] .back-btn:hover,
+html[data-theme="light"] .back-button:hover,
+html[data-theme="light"] .app-outline-button:hover {
+    background: rgb(var(--veu-rgb) / .1) !important;
+}
+
+/* estes sao os de acao: fundo violeta, texto claro, nos dois temas */
+html[data-theme="light"] .primary-btn,
+html[data-theme="light"] .publish-btn,
+html[data-theme="light"] .app-primary-button,
+html[data-theme="light"] .connect-btn:hover,
+html[data-theme="light"] .edit-profile-btn:hover {
+    color: var(--claro) !important;
+    background: var(--marca) !important;
+    border-color: transparent !important;
+}
+
+html[data-theme="light"] nav a,
+html[data-theme="light"] .app-nav a {
+    color: var(--tinta-fraca);
+}
+
+html[data-theme="light"] nav a.active,
+html[data-theme="light"] .app-nav a.active,
+html[data-theme="light"] nav a:hover {
+    color:var(--tinta);
+}
+
+
+/* =========================================
+   TEMA CLARO: a tinta
+   --tinta-alta, --tinta-media e --tinta-fraca so aparecem como cor de
+   texto (conferido: zero usos como fundo ou borda). Entao no tema claro
+   elas viram escuras, e todo texto secundario do app fica legivel de uma
+   vez, sem mexer regra por regra. --tinta nao entra aqui: no tema claro
+   ela e a cor das superficies.
+========================================= */
+
+html[data-theme="light"] {
+    /* A rampa inteira vira de uma vez. Como toda superficie do app agora
+       sai de --fundo/--painel/--linha e todo texto sai de --tinta, virar o
+       tema e reescrever esta lista: nao precisa de regra por componente.
+       Era isso que faltava para o tema claro funcionar fora de
+       Configuracoes (chat e verificacao ficavam brancos no branco). */
+    --fundo: #f1f0fa;
+    --fundo-2: #eae8f6;
+    --painel: #ffffff;
+    --painel-2: #f6f4fc;
+    --painel-3: #ece9f7;
+    --linha: #e2def1;
+    --linha-forte: #cec8e6;
+    --linha-2: #b4add4;
+    --tinta-fraca: #5b567e;
+    --tinta-media: #4e4972;
+    --tinta-alta: #221f3d;
+    --tinta: #14122a;
+    --marca: #4b31d6;
+    --marca-clara: #4b31d6;
+    --painel-rgb: 255 255 255;
+    --veu-rgb: 20 18 42;
+
+    /* as semanticas tambem escurecem, senao somem no branco */
+    --ok: #08492f;
+    --ok-claro: #0a6b45;
+    --erro: #c22045;
+    --erro-claro: #d9385c;
+    --aviso: #8a5a00;
+    --aviso-claro: #7a5100;
+    --info: #0d6e93;
+    --info-claro: #125a78;
+}
+
+/* circulo de avatar e de icone: no claro o fundo some e a letra branca
+   fica sobre branco. Mantem o circulo colorido. */
+html[data-theme="light"] .profile-avatar,
+html[data-theme="light"] .mini-avatar,
+html[data-theme="light"] .person-avatar,
+html[data-theme="light"] .platform-icon,
+html[data-theme="light"] .activity-dot {
+    color: var(--claro) !important;
+    background: var(--marca) !important;
+}
+
+
+/* Botao sem classe, em Configuracoes, herdava texto claro sobre fundo
+   claro. So aqui: pintar TODO botao de escuro quebra os que ficam sobre
+   fundo colorido. */
+html[data-theme="light"] .settings-actions button,
+html[data-theme="light"] .bubble-preview span {
+    color: var(--tinta);
+    background: rgb(var(--veu-rgb) / .05);
+    border-color: rgb(var(--veu-rgb) / .18);
+}
+
+
+/* =========================================
+   TEMA CLARO: os botoes das paginas de lista
+   Eventos, Empresas e Biblioteca tem familias de botao proprias
+   (.filter-button, .library-tab, .logo). Elas herdavam texto claro e
+   sumiam no fundo branco.
+========================================= */
+
+html[data-theme="light"] .filter-button,
+html[data-theme="light"] .library-tab,
+html[data-theme="light"] .logo,
+html[data-theme="light"] .back-button,
+html[data-theme="light"] .app-outline-button,
+html[data-theme="light"] .directory-hero a,
+html[data-theme="light"] .company-hero a,
+html[data-theme="light"] .search-box input {
+    color: var(--tinta) !important;
+}
+
+html[data-theme="light"] .filter-button.active,
+html[data-theme="light"] .library-tab.active {
+    color: var(--claro) !important;
+    background: var(--marca) !important;
+    border-color: transparent !important;
+}
+
+
+/* =========================================
+   ICONES
+   Traco em currentColor: o icone herda a cor do texto e acompanha o
+   tema sozinho. Antes a interface usava emoji e caracteres de texto,
+   que mudam de desenho conforme o sistema e nao alinham com a linha.
+========================================= */
+
+.ico {
+    flex: none;
+    vertical-align: -.2em;
+}
+
+/* icone colado ao texto fora de um flex (link, rotulo) */
+a > .ico:last-child,
+span > .ico:last-child,
+small > .ico:last-child,
+summary > .ico:last-child {
+    margin-left: 5px;
+}
+
+/* nas acoes do feed o icone e o texto andam juntos */
+.acao-icone {
+    display: inline-flex;
+    align-items: center;
+}
+
+.feed-action {
+    display: inline-flex;
+    align-items: center;
+    gap: 7px;
+}
+
+/* curtido: o coracao cheio ganha a cor da acao */
+.feed-action.liked .acao-icone { color: var(--erro); }
+
+/* caixas que antes seguravam um emoji: agora centram o SVG */
+.platform-icon,
+.account-feature-icon,
+.admin-lock > span,
+.dialog-symbol,
+.empty-icon,
+.search-icon,
+.social-icon,
+#toastIcon,
+.seal-mini > span {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    line-height: 0;
+}
+
+
+/* =========================================
+   BARRA DE ROLAGEM
+   A do sistema é cinza claro e aparece como um corte branco no meio de
+   uma tela escura. Esta sai da rampa, então acompanha o tema sozinha.
+   Repetida no outro arquivo pelo mesmo motivo da rampa: a home não
+   carrega o app-theme.css.
+========================================= */
+
+* {
+    scrollbar-width: thin;
+    scrollbar-color: var(--linha-forte) transparent;
+}
+
+::-webkit-scrollbar { width: 13px; height: 13px; }
+::-webkit-scrollbar-track { background: transparent; }
+
+::-webkit-scrollbar-thumb {
+    border: 4px solid transparent;
+    border-radius: 999px;
+    background: var(--linha-forte);
+    background-clip: padding-box;
+}
+
+::-webkit-scrollbar-thumb:hover {
+    background: var(--linha-2);
+    background-clip: padding-box;
+}
+
+::-webkit-scrollbar-thumb:active {
+    background: var(--marca);
+    background-clip: padding-box;
+}
+
+::-webkit-scrollbar-corner { background: transparent; }
+
+
+/* =========================================
+   REDUZIR MOVIMENTO
+   A mesma regra existia so no style.css, e dez telas nao carregam aquele
+   arquivo: Empresas, Eventos, Verificacao, Admin, Biblioteca, Onboarding,
+   Instalar, Trocar conta, Nova senha e o retorno da Steam. Nelas, quem
+   pediu menos movimento no sistema continuava vendo tudo animar.
+========================================= */
+
+@media (prefers-reduced-motion: reduce) {
+    html { scroll-behavior: auto; }
+    * { transition: none !important; animation: none !important; }
+}
+
+
+/* As telas que nao carregam o style.css ficam sem o reset de box-sizing
+   que mora la. No admin-reset isso somava os 35px de padding por fora e
+   a pagina vazava 26px no celular. */
+.admin-reset, .admin-reset * { box-sizing: border-box; }
+
+
+/* =========================================
+   LINK SEM COR PROPRIA
+   Sem isto o navegador usa o azul dele (#0000ee), que sobre fundo
+   escuro da 2:1. Seletor de um elemento so: qualquer regra com classe
+   ganha desta, entao ela so alcanca o link que ninguem pintou.
+========================================= */
+
+a { color: var(--marca-clara); }
+
+
+/* =========================================
+   CELULAR: a caixinha de aceite
+   17px e um alvo de mira, nao de dedo. A caixa vai a 22px e a linha
+   inteira passa de 44px de altura. O <label> envolve a caixa, entao
+   tocar no texto tambem marca (menos no link, que abre as regras).
+========================================= */
+@media (max-width: 760px) {
+    .register-safety-consent {
+        align-items: center;
+        gap: 12px!important;
+        padding: 6px 0;
+        font-size: 13px!important;
+    }
+    .register-safety-consent input { width: 22px!important; height: 22px!important; margin: 0!important }
+    .birth-privacy { font-size: 12.5px }
+}
