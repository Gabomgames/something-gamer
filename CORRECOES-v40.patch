+@import url('https://fonts.googleapis.com/css2?family=Archivo+Expanded:wght@500..800&family=Inter:wght@400;500;600;700&display=swap');
+
+/* =========================================
+   A RAMPA
+   Uma escala so, do fundo ao texto, e um violeta so. Antes o app
+   tinha 361 cores diferentes; quase todas eram o mesmo preto ou o
+   mesmo cinza escritos de um jeito ligeiramente diferente.
+   Esta lista esta repetida no style.css porque a home carrega
+   so aquele arquivo. Mudou aqui, muda la.
+========================================= */
+
+:root {
+    --fundo: #0c0b18;
+    --fundo-2: #110f20;
+    --painel: #14122a;
+    --painel-2: #1b1834;
+    --painel-3: #222040;
+    --linha: #262343;
+    --linha-forte: #363159;
+    --linha-2: #474273;
+    --tinta-fraca: #847eb2;   /* claro o bastante para passar em AA (4.6:1) */
+    --tinta-media: #9b97c2;
+    --tinta-alta: #c9c6e4;
+    --tinta: #f2f0fd;
+    --marca-escura: #4b31d6;
+    --marca: #6a4dff;
+    --marca-clara: #8a79ff;
+    --claro: #f7f6fd;
+    --escuro: #14122a;   /* superficie clara fixa: nao vira com o tema */
+
+    /* os mesmos tons em componentes RGB, para entrar em rgb(... / alfa).
+       Sem isto todo fundo translucido fica preso ao tema escuro. */
+    --painel-rgb: 20 18 42;
+    --veu-rgb: 255 255 255;
+    --display: "Archivo Expanded", Archivo, "Arial Narrow", Arial, sans-serif;
+
+    /* as quatro cores que significam alguma coisa. Antes eram 29 verdes,
+       21 cianos, 17 vermelhos e 13 ambares diferentes. */
+    --ok: #3ddc97;
+    --ok-claro: #8af0c4;
+    --ok-escuro: #1b8d67;
+    --erro: #ff6b81;
+    --erro-claro: #ffb0bb;
+    --erro-escuro: #b3244a;
+    --aviso: #ffc64f;
+    --aviso-claro: #ffe0a0;
+    --aviso-escuro: #b97c10;
+    --info: #4cc9f0;
+    --info-claro: #9fe4fa;
+    --info-escuro: #1b7fa8;
+}
+
+/* os titulos do app usam a mesma fonte da home; antes so a home tinha display */
+h1, h2, h3 {
+    font-family: var(--display);
+    letter-spacing: -.02em;
+    /* carregamos a Archivo Expanded de 500 a 800. Sem esta linha, uma
+       regra que pedisse 900 faria o navegador engrossar o traco na
+       marra, e o titulo borra. */
+    font-synthesis-weight: none;
+}
+
+/* Quando a regra nao diz o fundo, o Chrome pinta o botao com o cinza dele
+   (#f0f0f0). Com texto claro em cima, o botao some. Era o caso do
+   "Gerenciar assinatura" na pagina de verificacao. */
+button {
+    background: transparent;
+    font-family: inherit;
+}
+
+:root {
+    --app-bg: var(--fundo);
+    --app-panel: var(--fundo);
+    --app-panel-2: var(--fundo-2);
+    --app-border: rgb(var(--veu-rgb) / .11);
+    --app-muted: var(--tinta-media);
+    --app-text: var(--tinta);
+    --app-blue: #08b7f2;
+    --app-violet: #6d35ff;
+    --app-gradient: linear-gradient(110deg, var(--app-blue), var(--app-violet));
+    /* botão usa cor sólida; o gradiente continua nos avatares e selos */
+    --app-primary: var(--marca);
+    --app-primary-hover: var(--marca);
+}
+
+
+body:not(.home-page):not(.login-page) {
+    min-height: 100vh;
+    color: var(--app-text);
+    font-family: Inter, system-ui, sans-serif;
+    background-color: var(--app-bg);
+    /* tinha grade quadriculada e um brilho roxo atrás de toda página do app */
+    background-image: none;
+}
+
+
+button, a, input, textarea { font: inherit; }
+
+button, a { transition: .2s ease; }
+
+button:focus-visible, a:focus-visible, input:focus-visible, textarea:focus-visible { outline: 2px solid var(--marca-clara); outline-offset: 3px; }
+
+button:not(:disabled), a { cursor: pointer; }
+
+
+.sg-header, .topbar, .onboarding-header {
+    background: rgb(var(--painel-rgb) / .88) !important;
+    border-bottom: 1px solid var(--app-border) !important;
+    backdrop-filter: blur(20px);
+}
+
+
+.dashboard { max-width: 1320px !important; padding-top: 130px !important; }
+
+.profile-card, .dashboard-panel, .create-post, .connection-card, .edit-card, .login-box, .search-area, .game-card {
+    border: 1px solid var(--app-border) !important;
+    background: linear-gradient(145deg, rgba(21,23,32,.96), rgba(10,10,14,.98)) !important;
+    box-shadow: 0 24px 70px rgba(0,0,0,.24);
+}
+
+.profile-card { overflow: hidden; }
+
+.profile-background { display: none !important; /* brilho decorativo atrás do perfil */ }
+
+.profile-type, .panel-label, .connections-heading > span, .tag, .eyebrow { color: var(--marca-clara); letter-spacing: .08em; font-weight: 700; }
+
+.profile-info h1, .edit-header h1, .hero h1 { letter-spacing: -.045em; }
+.promotion-banner button{padding:12px 18px;white-space:nowrap;color:var(--tinta);border:0;border-radius:11px;background:var(--app-primary);font-weight:750;cursor:pointer}
+
+
+.login-btn, .edit-profile-btn, .connect-btn, .primary-btn, .publish-btn, .panel-link, .back-btn, .back-button, .app-primary-button {
+    min-height: 44px;
+    /* sem isto o texto encosta na borda: era por isso que "Ver todos" e
+       "Conectar" apareciam espremidos dentro de um quadradinho */
+    padding: 0 16px;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    border: 1px solid rgb(var(--veu-rgb) / .14) !important;
+    border-radius: 12px !important;
+    color: var(--claro) !important;
+    background: rgb(var(--veu-rgb) / .055) !important;
+    text-decoration: none;
+    font-weight: 700;
+}
+
+.primary-btn, .publish-btn, .connect-btn:hover, .edit-profile-btn:hover, .app-primary-button {
+    background: var(--app-primary) !important;
+    border-color: transparent !important;
+    box-shadow: 0 12px 30px rgba(106,77,255,.25);
+}
+
+.login-btn:hover, .panel-link:hover, .back-btn:hover, .back-button:hover { background: rgb(var(--veu-rgb) / .1) !important; transform: translateY(-1px); }
+
+.connect-btn.connected { color: var(--ok-claro) !important; border-color: rgba(79,226,166,.35) !important; }
+
+
+.stat-card { background: rgb(var(--veu-rgb) / .035) !important; border: 1px solid var(--app-border) !important; border-radius: 16px !important; }
+
+.stat-card strong { color: var(--app-accent, var(--marca-clara)); }
+
+.post-action, .post-input, .post-type { border-radius: 12px !important; }
+
+.post-action:hover, .post-type:hover, .post-type.active { border-color: rgba(111,74,255,.6) !important; background: rgba(91,62,255,.12) !important; }
+
+.post-modal-box { border: 1px solid var(--app-border) !important; background: var(--fundo) !important; box-shadow: 0 28px 100px var(--fundo); }
+
+.post-form input, .post-form textarea, .edit-card input, .edit-card textarea { color: var(--tinta) !important; background: var(--fundo) !important; border: 1px solid var(--app-border) !important; border-radius: 12px !important; }
+
+.post-form input:focus, .post-form textarea:focus, .edit-card input:focus, .edit-card textarea:focus { border-color: var(--marca-clara) !important; box-shadow: 0 0 0 4px rgba(112,87,255,.12); }
+
+
+.connection-card { min-height: 92px; border-radius: 18px !important; }
+
