+
+.platform-icon.steam-icon img {
+    width: 25px;
+    height: 25px;
+}
+
+.platform-icon.playstation-icon img {
+    width: 24px;
+    height: 24px;
+}
+
+.developer-mode-chip{position:fixed;z-index:20000;right:14px;bottom:14px;padding:8px 11px;border:1px solid rgba(127,108,255,.45);border-radius:9px;color:var(--tinta-alta);background:rgb(var(--painel-rgb) / .9);font:700 11px/1 system-ui;box-shadow:0 10px 35px rgba(0,0,0,.35);backdrop-filter:blur(12px)}
+
+.reset-modal{position:fixed;z-index:15000;inset:0;display:grid;place-items:center;padding:20px;opacity:0;visibility:hidden;transition:.25s}.reset-modal.active{opacity:1;visibility:visible}.reset-overlay{position:absolute;inset:0;width:100%;height:100%;border:0;background:rgb(var(--painel-rgb) / .84);backdrop-filter:blur(12px)}.reset-card{position:relative;width:min(470px,100%);padding:34px;border:1px solid rgb(var(--veu-rgb) / .13);border-radius:24px;color:var(--tinta);background: var(--fundo);box-shadow:0 35px 110px var(--fundo)}.reset-close{position:absolute;top:18px;right:18px;width:36px;height:36px;border:1px solid rgb(var(--veu-rgb) / .1);border-radius:10px;color:var(--tinta);background:var(--painel);font-size:22px}.reset-card h2{margin:12px 0 8px;font-size:32px;letter-spacing:-.04em}.reset-card>p{color:var(--tinta-media);line-height:1.55}.reset-step{display:none;gap:9px;margin-top:24px}.reset-step.active{display:grid}.reset-step label{margin-top:7px;color:var(--tinta-alta);font-size:13px;font-weight:700}.reset-step input{box-sizing:border-box;width:100%;height:50px;padding:0 14px;border:1px solid rgb(var(--veu-rgb) / .13);border-radius:11px;outline:0;color:var(--tinta);background:var(--fundo);font-size:15px}.reset-step input:focus{border-color:var(--marca-clara);box-shadow:0 0 0 4px rgba(112,87,255,.12)}.reset-step .primary-btn{width:100%;height:50px;margin-top:12px}.reset-resend{padding:10px;border:0;color:var(--marca-clara);background:transparent;font-weight:700}.reset-card .auth-message{margin:14px 0 0}.forgot-password{display:block;margin:-2px 0 14px auto;border:0;color:var(--marca-clara);background:transparent;font-weight:700;cursor:pointer}.forgot-password:hover{color:var(--tinta)}@media(max-width:520px){.reset-card{padding:28px 20px}.reset-card h2{font-size:28px}}
+.reset-email-note{display:block;margin-top:11px;color:var(--tinta-fraca);font-size:12px;line-height:1.5}
+
+
+/* =========================================
+   BARRA DE ROLAGEM
+   A do sistema é cinza claro e aparece como um corte branco no meio de
+   uma tela escura. Esta sai da rampa, então acompanha o tema sozinha.
+   Repetida no outro arquivo pelo mesmo motivo da rampa: a home não
+   carrega o app-theme.css.
+========================================= */
+
+* {
+    scrollbar-width: thin;
+    scrollbar-color: var(--linha-forte) transparent;
+}
+
+::-webkit-scrollbar { width: 13px; height: 13px; }
+::-webkit-scrollbar-track { background: transparent; }
+
+::-webkit-scrollbar-thumb {
+    border: 4px solid transparent;
+    border-radius: 999px;
+    background: var(--linha-forte);
+    background-clip: padding-box;
+}
+
+::-webkit-scrollbar-thumb:hover {
+    background: var(--linha-2);
+    background-clip: padding-box;
+}
+
+::-webkit-scrollbar-thumb:active {
+    background: var(--marca);
+    background-clip: padding-box;
+}
+
+::-webkit-scrollbar-corner { background: transparent; }
+
+
+/* =========================================
+   PAGINA 404 E O ITEM MARCADO NO MENU
+========================================= */
+
+.perdida {
+    min-height: calc(100vh - 78px - 91px);
+    padding: 148px var(--recuo) 96px;
+    display: grid;
+    align-content: center;
+}
+
+.perdida-codigo {
+    margin: 0 0 14px;
+    font-family: var(--display);
+    font-size: 14px;
+    font-weight: 700;
+    color: var(--marca-clara);
+}
+
+.perdida h1 {
+    margin: 0;
+    max-width: 16ch;
+    font-family: var(--display);
+    font-size: clamp(37px, 5.4vw, 66px);
+    font-weight: 800;
+    line-height: .96;
+    letter-spacing: -.04em;
+}
+
+.perdida-texto {
+    margin: 22px 0 0;
+    max-width: 46ch;
+    font-size: 17px;
+    line-height: 1.6;
+    color: #b9b5d8;
+}
+
+.perdida-portas {
+    margin: 36px 0 0;
+    padding: 0;
+    list-style: none;
+    display: grid;
+    gap: 2px;
+    max-width: 420px;
+}
+
+.perdida-ajuda {
+    margin: 40px 0 0;
+    font-size: 15px;
+    color: var(--tinta-media);
+}
+.perdida-ajuda a { color: var(--tinta); }
+
+/* a faixa que voce esta lendo fica marcada no menu e no herói */
+nav a.atual {
+    color: var(--tinta);
+}
+nav a.atual::after {
+    width: 100%;
+}
+.porta a.atual {
+    background: rgb(var(--veu-rgb) / .06);
+    padding-left: 24px;
+}
+
+
+/* =========================================
+   ICONES
+   Repetido do app-theme.css: login, home e 404 nao carregam aquele
+   arquivo. Foi por isso que a seta do "Voltar" ficou desalinhada.
+========================================= */
+
+.ico {
+    flex: none;
+    vertical-align: -.2em;
+}
+
+a > .ico:last-child,
+span > .ico:last-child,
+small > .ico:last-child {
+    margin-left: 5px;
+}
+
+
+/* =========================================
+   ANEL DE FOCO
+   Repetido do app-theme.css: login, home e 404 nao carregam aquele
+   arquivo. Os seletores com ID estao aqui de proposito - #loginForm
+   input apaga o contorno e so perde para outra regra com ID.
+========================================= */
+
+button:focus-visible,
+a:focus-visible,
+input:focus-visible,
+textarea:focus-visible,
+select:focus-visible,
+summary:focus-visible,
+#loginForm input:focus-visible,
+#registerForm input:focus-visible,
+.post-form input:focus-visible,
+.post-form textarea:focus-visible {
+    outline: 2px solid var(--marca-clara);
+    outline-offset: 3px;
+}
+
+
+/* =========================================
+   REGRAS DA COMUNIDADE
+   Pagina de texto: a medida e curta de proposito, porque aqui o que
+   importa e ler ate o fim.
+========================================= */
+
+.regras {
+    /* A calha aqui e fixa, e NAO o --recuo. O --recuo e a calha das
+       faixas que ocupam a tela inteira: ele cresce junto com a janela
+       ((100vw - --medida) / 2) para empurrar o conteudo ate a medida.
+       Esta coluna nao precisa disso, porque ja se centraliza sozinha
+       com margin auto.
+
+       E como o box-sizing do projeto e border-box, esse padding era
+       descontado POR DENTRO da medida. A 1280px ainda passava (sobrava
+       526px de texto); a 1900px o --recuo dava 360px de cada lado, os
+       720px comiam os 626px inteiros e a coluna fechava em zero. Era
+       por isso que a pagina so quebrava em tela grande, e eu tinha
+       conferido em tela pequena.
+
+       O calc devolve os 62ch de leitura depois de descontar a calha. */
+    max-width: calc(62ch + 44px);
+    margin: 0 auto;
+    padding: 148px 22px 100px;
+}
+
+.regras h1 {
+    margin: 0;
+    max-width: 14ch;
+    font-family: var(--display);
+    font-size: clamp(36px, 5vw, 60px);
+    font-weight: 800;
+    line-height: .96;
+    letter-spacing: -.04em;
+}
+
+.regras-lead {
+    margin: 22px 0 0;
+    font-size: 18px;
+    line-height: 1.62;
+    color: var(--tinta-alta);
+}
+
+.regra {
+    margin-top: 52px;
+    padding-top: 34px;
+    border-top: 1px solid var(--linha);
+}
+
+.regra h2 {
+    margin: 0 0 14px;
+    font-family: var(--display);
+    font-size: clamp(22px, 2.4vw, 28px);
+    font-weight: 700;
+    line-height: 1.1;
+    letter-spacing: -.028em;
+}
+
+.regra p {
+    margin: 0 0 14px;
+    font-size: 16px;
+    line-height: 1.7;
+    color: var(--tinta-media);
+}
+
+.regra strong { color: var(--tinta); font-weight: 600; }
+
+.regra-nota {
+    margin-top: 18px !important;
+    padding-left: 15px;
+    border-left: 2px solid var(--marca);
+    font-size: 15px !important;
+}
+
+.regras-lista {
+    margin: 0 0 14px;
+    padding: 0;
+    list-style: none;
+    display: grid;
+    gap: 11px;
+}
+
+.regras-lista li {
+    position: relative;
+    padding-left: 17px;
+    font-size: 16px;
+    line-height: 1.6;
+    color: var(--tinta-media);
+}
+
+.regras-lista li::before {
+    content: "";
+    position: absolute;
+    left: 0;
+    top: 9px;
+    width: 6px;
+    height: 6px;
+    border-radius: 2px;
+    background: var(--marca-clara);
+}
+
+/* o numero e o conteudo aqui, entao ele tem o peso */
+.regras-numeros li { padding-left: 0; }
+.regras-numeros li::before { display: none; }
+.regras-numeros b {
+    display: inline-block;
+    min-width: 5.5ch;
+    font-family: var(--display);
+    font-weight: 700;
+    color: var(--tinta);
+}
+
+.regra b { color: var(--tinta); font-weight: 700; }
+
+.regras-escada {
+    margin: 0 0 14px;
+    padding-left: 22px;
+    display: grid;
+    gap: 11px;
+}
+
+.regras-escada li {
+    font-size: 16px;
+    line-height: 1.6;
+    color: var(--tinta-media);
+}
+.regras-escada::marker, .regras-escada li::marker { color: var(--marca-clara); }
+
+.regra .publico-btn {
+    --cor: var(--marca-clara);
+    margin-top: 6px;
+    text-decoration: none;
+    display: inline-flex;
+    align-items: center;
+}
+
+@media (max-width: 760px) {
+    .regras { padding-top: 112px; }
+}
+
+
+/* =========================================
+   LINK SEM COR PROPRIA
+   Sem isto o navegador usa o azul dele (#0000ee), que sobre fundo
+   escuro da 2:1. Seletor de um elemento so: qualquer regra com classe
+   ganha desta, entao ela so alcanca o link que ninguem pintou.
+========================================= */
+
+a { color: var(--marca-clara); }
+
+
+/* =========================================
+   CELULAR
+   Tres coisas que so aparecem no telefone e que nao da para ver
+   medindo no monitor:
+
+   1. Campo com letra menor que 16px: o Safari do iPhone da zoom
+      sozinho quando a pessoa toca no campo, e a pagina fica torta
+      ate recarregar. Os campos do login e do cadastro estavam em
+      13px. O !important e para passar por cima das regras antigas
+      de cada componente; este projeto ja fazia isso no formulario
+      de suporte e no campo do chat, pelo mesmo motivo.
+
+   2. Alvo de toque: o dedo nao tem a mira do ponteiro. Abaixo de
+      44px de altura o erro de toque vira regra. Os links do rodape
+      tinham 17px, o "Criar conta" tinha 15px.
+
+   3. 11px cabe no monitor e nao cabe na mao.
+========================================= */
+
+@media (max-width: 760px) {
+
+    /* 1. o zoom do iPhone */
+    input:not([type="checkbox"]):not([type="radio"]):not([type="range"]),
+    select,
+    textarea {
+        font-size: 16px !important;
+    }
+
+    /* 2. alvo de toque de 44px
+       A altura vem do padding, e a margem negativa devolve o espaco
+       que o padding tomou: cresce a area do dedo sem mexer no desenho. */
+    .footer-links { flex-wrap: wrap; gap: 0 20px; margin: -14px 0; }
+    .footer-links a { display: inline-block; padding: 14px 0; }
+
+    .brand { padding: 5px 0; }
+    .login-btn { min-height: 44px; }
+
+    .login-footer { align-items: center; margin-top: 11px; }
+    .login-footer a { display: inline-block; padding: 15px 6px; margin: -15px -6px; }
+
+    .back-home { padding: 14px 0; margin-top: 14px; }
+    .forgot-password { padding: 14px 0; margin-bottom: 0; }
+
+    /* 3. tamanho de letra */
+    #loginForm label,
+    #registerForm label { font-size: 13px; }
+
+    .login-footer,
+    .login-footer a,
+    .back-home { font-size: 13px; }
+
+    .footer-company { font-size: 14px; }
+    .login-box > p { font-size: 14px; }
+    .porta span, .publico-plataformas p { font-size: 14px; }
+    .reset-email-note { font-size: 13px; }
+    .forgot-password { font-size: 13px; }
+
+    /* alvos que sobraram na segunda medicao */
+    .hero-acoes a { padding: 12px 0; }
+    .login-brand { padding: 2px 0; }
+    .reset-close { width: 44px; height: 44px; }
+}
