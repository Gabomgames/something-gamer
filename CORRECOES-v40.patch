diff -ruN '--exclude=CORRECOES-v40.patch' original/android-app/app/build.gradle entrega/android-app/app/build.gradle
--- original/android-app/app/build.gradle	2026-09-13 17:25:53.000000000 -0300
+++ entrega/android-app/app/build.gradle	2026-09-14 11:43:28.153819500 -0300
@@ -1,13 +1,49 @@
 plugins { id 'com.android.application' }
 
+// A versão vem do build-info.json da raiz: um lugar só, em vez de repetir o número.
+// v40 -> versionName "40", versionCode 40.
+def infoDoBuild = new groovy.json.JsonSlurper().parse(file("../../build-info.json"))
+def nomeDaVersao = (infoDoBuild.version ?: "v40").toString().replaceFirst(/^v/, "")
+def codigoDaVersao = Integer.parseInt(nomeDaVersao.replaceAll(/[^0-9]/, ""))
+
+// Assinatura de verdade quando as variáveis existem (CI com os secrets configurados).
+def caminhoDaChave = System.getenv("ANDROID_KEYSTORE_PATH")
+def temChavePropria = caminhoDaChave != null && !caminhoDaChave.isEmpty() && file(caminhoDaChave).exists()
+
 android {
     namespace 'com.somethinggamer.app'
     compileSdk 35
+
     defaultConfig {
         applicationId 'com.somethinggamer.app'
         minSdk 24
         targetSdk 35
-        versionCode 1
-        versionName '1.0.0'
+        versionCode codigoDaVersao
+        versionName nomeDaVersao
+    }
+
+    signingConfigs {
+        release {
+            if (temChavePropria) {
+                storeFile file(caminhoDaChave)
+                storePassword System.getenv("ANDROID_KEYSTORE_PASSWORD")
+                keyAlias System.getenv("ANDROID_KEY_ALIAS")
+                keyPassword System.getenv("ANDROID_KEY_PASSWORD")
+            }
+        }
+    }
+
+    buildTypes {
+        release {
+            // o APK distribuído era assembleDebug: depurável e sempre versionCode 1.
+            debuggable false
+            minifyEnabled false
+            // sem a chave própria cai na de debug: instalável para testar,
+            // mas nunca depurável. Para a Play Store, configure os secrets.
+            signingConfig temChavePropria ? signingConfigs.release : signingConfigs.debug
+        }
+        debug {
+            versionNameSuffix '-debug'
+        }
     }
 }
